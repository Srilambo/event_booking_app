{
  "outputDirectory": "event_booking_app/build/web",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api?path=/api/$1"
    },
    {
      "source": "/health",
      "destination": "/api?path=/health"
    },
    {
      "source": "/((?!api|health|index\\.html|assets|canvaskit|icons|.*\\.js|.*\\.png|.*\\.json|.*\\.otf|.*\\.ttf).*)",
      "destination": "/index.html"
    }
  ]
}
