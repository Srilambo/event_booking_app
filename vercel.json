{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api?path=/api/$1"
    },
    {
      "source": "/health",
      "destination": "/api?path=/health"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/event_booking_app/build/web/assets/$1"
    },
    {
      "source": "/canvaskit/(.*)",
      "destination": "/event_booking_app/build/web/canvaskit/$1"
    },
    {
      "source": "/icons/(.*)",
      "destination": "/event_booking_app/build/web/icons/$1"
    },
    {
      "source": "/(favicon\\.png|flutter\\.js|flutter_bootstrap\\.js|flutter_service_worker\\.js|main\\.dart\\.js|manifest\\.json|version\\.json)",
      "destination": "/event_booking_app/build/web/$1"
    },
    {
      "source": "/((?!api|health).*)",
      "destination": "/event_booking_app/build/web/index.html"
    }
  ]
}
