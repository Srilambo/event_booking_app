{
  "version": 2,
  "builds": [
    {
      "src": "event-booking-api/api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "event_booking_app/build/web/(.*)",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/event-booking-api/api/index.js"
    },
    {
      "src": "/health",
      "dest": "/event-booking-api/api/index.js?health=1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
