{
  "version": 2,
  "builds": [
    {
      "src": "event-booking-api/api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["event_booking_app/build/web/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/event-booking-api/api/index.js?path=/api/$1"
    },
    {
      "src": "/health",
      "dest": "/event-booking-api/api/index.js?path=/health"
    },
    {
      "src": "/(.*)",
      "dest": "/event-booking-api/api/index.js?path=/$1"
    }
  ]
}
