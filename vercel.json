{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api?path=/api/:path*"
    },
    {
      "source": "/health",
      "destination": "/api?path=/health"
    },
    {
      "source": "/((?!api|health).*)",
      "destination": "/event_booking_app/build/web/$1"
    }
  ]
}
