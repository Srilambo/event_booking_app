{
  "version": 2,
  "builds": [
    {
      "src": "event-booking-api/api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["event_booking_app/build/web/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/event-booking-api/api/index.js"
    }
  ]
}
