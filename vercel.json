{
  "version": 2,
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api?url=/api/$1"
    },
    {
      "source": "/health",
      "destination": "/api?url=/health"
    },
    {
      "source": "/((?!api|health|assets|canvaskit|icons|favicon.png|flutter.js|flutter_bootstrap.js|flutter_service_worker.js|main.dart.js|manifest.json|version.json).*)",
      "destination": "/index.html"
    }
  ]
}
