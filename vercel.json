{
  "outputDirectory": "event_booking_app/build/web",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api?path=/api/:path*"
    },
    {
      "source": "/health",
      "destination": "/api?path=/health"
    },
    {
      "source": "/((?!api|health).*)",
      "destination": "/index.html"
    }
  ]
}
