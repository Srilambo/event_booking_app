{
  "version": 2,
  "builds": [
    {
      "src": "event-booking-api/api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "event_booking_app/build/web/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/event-booking-api/api/index.js"
    },
    {
      "src": "/health",
      "dest": "/event-booking-api/api/index.js"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/event_booking_app/build/web/assets/$1"
    },
    {
      "src": "/canvaskit/(.*)",
      "dest": "/event_booking_app/build/web/canvaskit/$1"
    },
    {
      "src": "/icons/(.*)",
      "dest": "/event_booking_app/build/web/icons/$1"
    },
    {
      "src": "/(favicon\\.png|flutter\\.js|flutter_bootstrap\\.js|flutter_service_worker\\.js|main\\.dart\\.js|manifest\\.json|version\\.json)",
      "dest": "/event_booking_app/build/web/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/event_booking_app/build/web/index.html"
    }
  ]
}
